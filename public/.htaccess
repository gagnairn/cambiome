# En-têtes de sécurité — Apache (OVH, o2switch, Infomaniak, Ionos… la plupart
# des hébergements mutualisés français).
#
# Ce fichier n'a aucun effet sur GitHub Pages ; il est là pour que la migration
# vers un vrai hébergeur consiste à téléverser `dist/` et rien d'autre.
#
# Voir public/_headers pour la version Netlify / Cloudflare Pages et le
# commentaire qui explique pourquoi la CSP complète n'est pas répétée ici
# (Astro la génère en <meta> avec les hachages des scripts ; un en-tête CSP
# supplémentaire s'intersecterait avec elle et bloquerait ces scripts).

<IfModule mod_headers.c>
  # Clickjacking : `frame-ancestors` est la forme moderne, X-Frame-Options le
  # repli pour les navigateurs anciens.
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"

  # Pas de devinette de type MIME.
  Header always set X-Content-Type-Options "nosniff"

  # URL complète en interne, domaine seul vers l'extérieur.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Le site n'utilise aucune de ces API.
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()"

  Header always set Cross-Origin-Opener-Policy "same-origin"

  # HTTPS obligatoire deux ans. À n'activer qu'une fois le certificat en place
  # et le site joignable en HTTPS, sinon le site devient inaccessible.
  # `preload` volontairement omis (désinscription très lente).
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# Redirection HTTP -> HTTPS.
#
# À DÉCOMMENTER après le premier dépôt, et pas avant : c'est la seule règle de
# ce fichier qui puisse rendre le site inaccessible. Si Apache ne voit pas que
# la requête est déjà chiffrée, il redirige une requête HTTPS vers elle-même,
# indéfiniment.
#
# OVH documente trois formes selon l'offre (« Passer son site web en HTTPS ») :
# `%{SERVER_PORT} 80` et `%{HTTPS} off` pour le mutualisé, `%{ENV:HTTPS} !on`
# pour le Cloud Web. Rien n'indique laquelle s'applique ici sans l'essayer, et
# se tromper coûte le site. La règle ci-dessous exige donc que les trois
# indicateurs ET l'en-tête de proxy disent tous « pas de TLS » avant de
# rediriger : il suffit qu'un seul soit renseigné pour qu'aucune boucle ne soit
# possible.
#
# COMMENT TRANCHER SANS DEVINER. L'en-tête HSTS ci-dessus est déjà un
# révélateur : sa condition `expr=%{HTTPS} == 'on'` fait qu'il n'est émis que
# si Apache considère la requête comme chiffrée. Une fois le site déposé et le
# certificat en place :
#
#   curl -sI https://www.cambiome.fr | grep -i strict-transport
#
# S'il sort, `%{HTTPS}` est fiable sur cet hébergement et la forme simple
# suffirait. S'il ne sort pas, TLS est terminé en amont — et c'est alors la
# condition X-Forwarded-Proto ci-dessous qui fait tout le travail.
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteCond %{ENV:HTTPS} !=on
#   RewriteCond %{SERVER_PORT} !=443
#   RewriteCond %{HTTP:X-Forwarded-Proto} !=https
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# Domaine nu -> www. L'adresse officielle du site est www.cambiome.fr : sans
# cette redirection, les mêmes pages répondent à deux adresses, le
# référencement se partage entre elles et le <link rel="canonical"> généré par
# Astro n'en désigne qu'une.
# À DÉCOMMENTER une fois le certificat valable pour les DEUX noms — la cible
# est en `https://` en dur, donc un certificat qui ne couvrirait que `www`
# laisserait les visiteurs du domaine nu sur une erreur de certificat, plus
# rebutante qu'une simple page absente. Le contrôle :
#
#   echo | openssl s_client -connect cambiome.fr:443 -servername cambiome.fr \
#     2>/dev/null | openssl x509 -noout -text | grep -A1 "Subject Alternative"
#
# Les deux noms doivent y figurer. Le DNS, lui, est en place depuis le
# 2 septembre 2026 : les deux enregistrements A pointent sur l'hébergement.
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTP_HOST} ^cambiome\.fr$ [NC]
#   RewriteRule ^ https://www.cambiome.fr%{REQUEST_URI} [L,R=301]
# </IfModule>

# Le site est statique : aucun listing de répertoire.
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Page introuvable. GitHub Pages sert /404.html tout seul, par convention ;
# Apache ne le devine pas et afficherait sa propre page, celle qui ne ressemble
# à rien. Le chemin est absolu depuis la racine du site : c'est ce qu'attend
# `ErrorDocument`, et cela vaut pour une URL fausse à n'importe quelle
# profondeur. Le statut renvoyé reste bien 404 — Apache ne le remplace pas par
# une redirection —, ce qui importe autant aux moteurs qu'aux visiteurs.
ErrorDocument 404 /404.html
