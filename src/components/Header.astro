---
import { Image } from 'astro:assets';
import logoNoir from '~/assets/logos/logo-noir.png';
import { site } from '~/data/site';
import { lien } from '~/lib/base';

const nav = [
  { href: lien('/metiers'), label: 'Métiers' },
  { href: lien('/demarche'), label: 'Notre démarche' },
  { href: lien('/realisations'), label: 'Réalisations' },
  { href: lien('/contact'), label: 'Contact' },
];

const ici = Astro.url.pathname.replace(/\/$/, '');
const actif = (href: string) => ici === href.replace(/\/$/, '');
---

<header class="sticky top-0 z-40 border-b border-sable-200 bg-sable-50/90 backdrop-blur">
  <div class="container-page flex h-20 items-center justify-between gap-4">
    <a
      href={lien('/')}
      class="flex items-center gap-3"
      aria-label={`${site.nom} — accueil`}
    >
      <Image
        src={logoNoir}
        alt=""
        width={44}
        height={44}
        loading="eager"
        class="h-11 w-11"
      />
      <span class="leading-none">
        <span class="block font-display text-xl font-light tracking-[0.22em] text-encre">
          {site.nom}
        </span>
        <span class="mt-1 block font-display text-[0.62rem] tracking-[0.3em] text-ardoise-600 uppercase">
          {site.baseline}
        </span>
      </span>
    </a>

    <nav aria-label="Navigation principale" class="hidden md:block">
      <ul class="flex items-center gap-8">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={actif(item.href) ? 'page' : undefined}
                class:list={[
                  'text-sm transition-colors hover:text-ardoise-600',
                  actif(item.href)
                    ? 'text-ardoise-700 underline decoration-ardoise-400 underline-offset-8'
                    : 'text-encre/75',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Menu mobile : <details> natif, aucun JS -->
    <details class="group relative md:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-sable-300 text-encre [&::-webkit-details-marker]:hidden"
      >
        {/* Le libellé suit l'état du <details>, en CSS seule : un aria-label
            figé annoncerait « Ouvrir » alors que le menu est déjà ouvert. */}
        <span class="sr-only group-open:hidden">Ouvrir le menu</span>
        <span class="sr-only hidden group-open:block">Fermer le menu</span>
        <svg
          class="h-5 w-5 group-open:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
        <svg
          class="hidden h-5 w-5 group-open:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </summary>
      <nav
        aria-label="Navigation principale"
        class="absolute right-0 mt-3 w-60 rounded-lg border border-sable-200 bg-sable-50 p-2 shadow-lg shadow-ardoise-900/5"
      >
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={actif(item.href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-md px-4 py-3 text-sm hover:bg-sable-100',
                    actif(item.href) ? 'text-ardoise-700' : 'text-encre/80',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
