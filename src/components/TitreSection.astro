---
interface Props {
  surtitre?: string;
  titre: string;
  /**
   * Niveau de titre HTML — par défaut h2.
   *
   * `1` est réservé au titre principal d'une page : une page en compte un, et
   * un seul. L'apparence ne suit pas le niveau (les classes de taille sont
   * écrites ici, et `global.css` traite h1 à h4 pareillement) — c'est
   * volontaire, la hiérarchie du document et l'échelle typographique n'ont pas
   * à être le même réglage.
   */
  niveau?: 1 | 2 | 3;
  centre?: boolean;
  class?: string;
}

const {
  surtitre,
  titre,
  niveau = 2,
  centre = false,
  class: classe = '',
} = Astro.props;

const Balise = `h${niveau}` as 'h1' | 'h2' | 'h3';
---

<div class:list={[centre && 'text-center', classe]}>
  {
    surtitre && (
      <p class="font-display text-xs tracking-[0.28em] text-ardoise-600 uppercase">
        {surtitre}
      </p>
    )
  }
  <Balise class="mt-3 text-3xl leading-tight sm:text-4xl">{titre}</Balise>
  <div class:list={['rule-cernes mt-6 h-px w-24', centre && 'mx-auto']}></div>
  {
    Astro.slots.has('default') && (
      <div class:list={['mt-6 max-w-2xl text-encre/75', centre && 'mx-auto']}>
        <slot />
      </div>
    )
  }
</div>
