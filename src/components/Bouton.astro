---
/**
 * Les variantes se lisent par le fond sur lequel le bouton est posé, pas par
 * son apparence — c'est ce qui décide de sa couleur de texte :
 *
 *  - sur le fond de page  : `plein`, `contour`
 *  - sur une photo        : `clair`
 *  - sur un aplat de marque : `sur-marque`, `contour-sur-marque`
 *
 * Les deux dernières sont nécessaires parce que `clair` (blanc sur photo) ne
 * convient pas à un aplat de marque : un bouton blanc sur #9DC3D4 donne
 * 1,88:1, il disparaît. Elles s'expriment donc en `sur-marque`, l'encre, qui y
 * donne 9,03:1.
 *
 * Variantes plutôt que surcharges via `class` : deux utilitaires Tailwind
 * visant la même propriété sont départagés par leur ordre dans la feuille
 * produite, pas par l'ordre dans l'attribut. Une surcharge y marche par
 * chance.
 */
interface Props {
  href: string;
  variante?: 'plein' | 'contour' | 'clair' | 'sur-marque' | 'contour-sur-marque';
  class?: string;
}

const { href, variante = 'plein', class: classe = '' } = Astro.props;

const styles = {
  plein:
    'border border-marque-bord bg-marque text-sur-marque hover:bg-marque-survol',
  // Contour au cran 500 et non au 400 : ce trait est la seule limite visible du
  // bouton, il lui faut 3:1 sur le fond de page (WCAG 1.4.11). Le 400 n'en donne
  // que 2,68:1 sur `sable-50`, le 500 en donne 4,61:1 — et 4,27:1 sur le
  // `sable-100` des sections en encart, l'autre fond sur lequel il se pose.
  contour:
    'border border-ciel-500 text-ciel-700 hover:border-ciel-600 hover:bg-ciel-50',
  clair: 'bg-white/95 text-encre hover:bg-white',
  'sur-marque': 'bg-sur-marque text-marque hover:bg-sur-marque/90',
  // 75 % et pas moins : le contour est la seule limite visible de ce bouton, il
  // lui faut 3:1 sur l'aplat (WCAG 1.4.11). À 40 % il tombait à 2,20:1 ; à 75 %
  // l'encre donne 5,14:1 sur #9DC3D4.
  'contour-sur-marque':
    'border border-sur-marque/75 text-sur-marque hover:border-sur-marque hover:bg-sur-marque/10',
} as const;
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-full px-7 py-3 text-sm tracking-wide transition-colors',
    styles[variante],
    classe,
  ]}
>
  <slot />
</a>
