---
import Bouton from '~/components/Bouton.astro';
import { contact } from '~/data/site';
import { appelContact } from '~/data/pages';
import { lien } from '~/lib/base';
import { telephoneInsecable } from '~/lib/texte';
---

<section class="container-page mt-24">
  {/* Aplat de marque : tout ce qui est posé dessus s'exprime en `sur-marque`,
      y compris les boutons. Le paragraphe est au même ton que le titre — sur
      un fond à mi-tons il ne reste pas 4,5:1 de marge pour un second ton, la
      hiérarchie passe donc par la taille. */}
  <div
    class="surface-marque rounded-lg bg-marque px-8 py-14 text-center text-sur-marque sm:px-14"
  >
    <h2 class="text-3xl leading-tight sm:text-4xl">{appelContact.titre}</h2>
    <p class="mx-auto mt-5 max-w-xl leading-relaxed">{appelContact.texte}</p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <Bouton href={lien('/contact')} variante="sur-marque">{appelContact.bouton}</Bouton>
      {
        contact.telephone && (
          <Bouton
            href={`tel:${contact.telephone.replace(/\s/g, '')}`}
            variante="contour-sur-marque"
          >
            {telephoneInsecable(contact.telephone)}
          </Bouton>
        )
      }
    </div>
  </div>
</section>
