---
/**
 * Fiche d'entreprise en JSON-LD (schema.org).
 *
 * C'est ce qui permet à un moteur de recherche de savoir que CAMBIOME est une
 * entreprise du bâtiment intervenant autour de Grenoble, joignable à tel
 * numéro, et non une page parmi d'autres. Pour une vitrine dont tout l'objet
 * est d'être trouvée localement, c'est le balisage qui compte le plus après le
 * titre.
 *
 * L'adresse déclarée est `contact.adresseVisible`, c'est-à-dire l'atelier et
 * non le siège. C'est un point qui décide du référencement local : les moteurs
 * rapprochent une fiche d'établissement du site par concordance du nom, de
 * l'adresse et du téléphone. Deux adresses valables mais différentes entre le
 * balisage et la fiche Google, et le rapprochement ne se fait pas — la fiche
 * perd l'appui du site. Le siège, lui, ne passe jamais par ici : les pages qui
 * le publient — mentions légales, et la ligne « Courrier » de la page
 * Contact — lisent `contact.adresse` directement. Il paraît donc en clair sur
 * le site sans jamais entrer dans le balisage, ce qui est exactement ce qu'on
 * veut : une seule adresse déclarée aux moteurs, celle de la fiche Google.
 *
 * ⚠ Le type n'est pas fixe, et c'est le point le plus important du fichier.
 *
 * `HomeAndConstructionBusiness` descend de `LocalBusiness`, donc de `Place` :
 * il décrit un établissement où l'on se rend, et Google en tire une fiche avec
 * itinéraire et horaires. C'est nettement plus fort en référencement local que
 * `Organization` — mais annoncer « venez ici » suppose que quelqu'un ouvre la
 * porte, et envoyer un client devant une porte fermée coûte plus cher que le
 * gain de référencement.
 *
 * Le type suit donc la donnée : `HomeAndConstructionBusiness` dès que
 * l'atelier déclare des horaires, `Organization` sinon. Rien à cocher, donc
 * rien à oublier — et surtout aucun état où le site inviterait à venir sans
 * dire quand. Remplir les horaires dans le CMS suffit à faire la bascule ;
 * les vider la défait.
 *
 * `areaServed` reste dans les deux cas : itinérante ou non, l'entreprise
 * intervient sur une zone, et c'est ce qui porte l'ancrage local tant que le
 * type est `Organization`.
 *
 * Le bloc est posé dans le <head> de chaque page avec le même `@id` : les
 * moteurs y voient une seule et même entité décrite plusieurs fois, pas neuf
 * entreprises homonymes. C'est la forme recommandée pour un balisage répété.
 *
 * Tout est dérivé de `site.ts`, donc du CMS : rien à retoucher ici quand un
 * numéro change. Un champ vide disparaît de la fiche — une donnée absente vaut
 * mieux qu'une donnée fausse, que les moteurs sanctionnent.
 */
import { atelier, contact, metiers, rge, rgeEnCours, site } from '~/data/site';
import { lien } from '~/lib/base';
import { joursSchema } from '~/lib/horaires';

const racine = new URL(lien('/'), Astro.site).href;

/**
 * `19 bis rue de la Liberté, 38600 Fontaine` -> rue / code postal / commune.
 * Si la saisie ne suit pas cette forme, tout part dans `streetAddress` : une
 * adresse d'un seul tenant reste juste, une adresse mal découpée ne l'est pas.
 */
const decoupee = contact.adresseVisible.match(/^(.*?),\s*(\d{5})\s+(.+)$/);

/**
 * `06 27 80 42 38` -> `+33627804238`. schema.org demande la forme
 * internationale : un numéro national est ambigu hors de France, et les fiches
 * d'établissement des moteurs s'appuient dessus pour rapprocher un numéro d'un
 * établissement connu. Une saisie déjà en `+…` est laissée telle quelle.
 */
const telephone = contact.telephone
  ? contact.telephone.replace(/[\s.-]/g, '').replace(/^0/, '+33')
  : '';

const adresse = contact.adresseVisible
  ? {
      '@type': 'PostalAddress',
      streetAddress: decoupee ? decoupee[1] : contact.adresseVisible,
      ...(decoupee && { postalCode: decoupee[2], addressLocality: decoupee[3] }),
      addressCountry: 'FR',
    }
  : undefined;

/**
 * Une entrée par plage saisie. `dayOfWeek` prend un tableau de jours : une
 * seule ligne couvre donc « lundi – vendredi », là où sept lignes diraient la
 * même chose.
 */
const ouverture = atelier.horaires.map((h) => ({
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: joursSchema(h.jours),
  opens: h.ouverture,
  closes: h.fermeture,
}));

/**
 * Les pages qui décrivent la même entreprise ailleurs.
 *
 * La fiche Google y a sa place au même titre que le compte Instagram : c'est
 * une page qui désigne cette entreprise-ci. Sa présence change pourtant
 * quelque chose de plus que celle d'un réseau social. Sans elle, le moteur
 * rapproche la fiche du site par concordance du nom, de l'adresse et du
 * téléphone — un raisonnement qui marche le plus souvent, et qu'une virgule
 * de différence dans l'adresse suffit à défaire. Le lien, lui, l'affirme.
 *
 * `sameAs` plutôt que `hasMap`, qui décrirait mieux un lien Maps mais
 * n'appartient qu'à `Place` : il faudrait le conditionner à la bascule, comme
 * `geo`, et il disparaîtrait le jour où l'atelier retire ses horaires — c'est
 * précisément le jour où le site aurait le plus besoin de dire que la fiche
 * est la sienne. `sameAs` existe sur les deux types.
 */
const profils = [contact.instagram, contact.ficheGoogle].filter(Boolean);

const fiche = {
  '@context': 'https://schema.org',
  '@type': atelier.accueille ? 'HomeAndConstructionBusiness' : 'Organization',
  '@id': `${racine}#entreprise`,
  name: site.nom,
  description: site.description,
  slogan: site.baseline,
  url: racine,
  image: new URL(lien('/og-image.jpg'), Astro.site).href,
  // `image` et `logo` ne jouent pas le même rôle : la première illustre
  // l'entreprise dans un résultat, le second l'identifie dans un panneau de
  // connaissance. Les moteurs attendent les deux, et prennent la marque
  // seule — pas la photo de chantier — pour le logo.
  logo: new URL(lien('/icon-512.png'), Astro.site).href,
  ...(contact.email && { email: contact.email }),
  ...(telephone && { telephone }),
  ...(adresse && { address: adresse }),
  /* `geo` et `openingHoursSpecification` appartiennent à `Place`, dont
     `Organization` ne descend pas : les émettre hors bascule produirait un
     balisage invalide. Les deux sont donc conditionnés au même drapeau que le
     type lui-même, et ne peuvent pas se retrouver seuls dans la fiche. */
  ...(atelier.accueille &&
    atelier.situe && {
      geo: {
        '@type': 'GeoCoordinates',
        latitude: atelier.latitude,
        longitude: atelier.longitude,
      },
    }),
  ...(atelier.accueille && { openingHoursSpecification: ouverture }),
  ...(profils.length > 0 && { sameAs: profils }),
  ...(contact.siret && { identifier: { '@type': 'PropertyValue', propertyID: 'SIRET', value: contact.siret } }),
  areaServed: { '@type': 'Place', name: site.zone },
  // Les métiers, tels qu'ils sont présentés au visiteur. `itemOffered` plutôt
  // qu'une simple liste de mots-clés : ce sont des prestations.
  makesOffer: metiers.map((m) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: m.titre, description: m.chapo },
  })),
  // La qualification sort de la fiche le jour où elle expire, comme partout
  // ailleurs sur le site : l'annoncer périmée serait une allégation trompeuse,
  // et ici elle serait affichée par le moteur de recherche lui-même.
  ...(rgeEnCours && {
    hasCredential: {
      '@type': 'EducationalOccupationalCredential',
      name: rge.certificat,
      credentialCategory: 'certification',
      recognizedBy: { '@type': 'Organization', name: rge.organisme },
      url: rge.attestation,
      validUntil: rge.fin,
    },
  }),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(fiche)} />
