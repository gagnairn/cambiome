---
import { Picture } from 'astro:assets';
import type { Realisation } from '~/data/realisations';

interface Props {
  items: Realisation[];
  /**
   * Niveau des titres de chantier. Il dépend du titre qui précède la galerie :
   * sur l'accueil elle suit un h2 (« Quelques réalisations ») et ses items
   * sont donc des h3 ; sur la page Réalisations elle suit le h1 de la page et
   * ils remontent en h2. Sans ce réglage, la seconde sauterait un niveau.
   */
  niveau?: 2 | 3;
  /**
   * Combien d'items charger sans attendre le défilement. Zéro par défaut :
   * sur l'accueil la galerie est tout en bas, et trois images chargées d'avance
   * y disputaient la bande passante à celle du hero, qui est l'image que le
   * visiteur regarde. Sur la page Réalisations, où la galerie commence sous le
   * titre, la première rangée mérite le traitement inverse.
   */
  eager?: number;
}

const { items, niveau = 3, eager = 0 } = Astro.props;

const Titre = `h${niveau}` as 'h2' | 'h3';
---

<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    items.map((r, i) => (
      <li class="overflow-hidden rounded-lg border border-sable-200 bg-white">
        <figure>
          <div class="aspect-4/3 overflow-hidden bg-sable-100">
            {/* AVIF, avec repli WebP — comme le hero de l'accueil, où le
                format a été retenu après mesure. La galerie est le gros du
                transfert du site : sept photos sur l'accueil, quatorze sur la
                page Réalisations.

                `quality` est à 60 et non à 50 comme le hero : là-bas la photo
                est vue sous un voile sombre qui pardonne beaucoup, ici elle est
                vue en clair. Une vignette de 500 px passe de 54 Ko (l'ancien
                WebP à 80) à 35 Ko. À 50 on descendrait à 24 Ko — à juger un
                jour côte à côte sur les photos les plus chargées en détail fin,
                l'arêtier et la fibre de bois.

                Une conséquence à connaître : ce réglage vaut pour les deux
                formats, Astro n'en prend qu'un. Le repli WebP descend donc de
                80 à 60 lui aussi. Il n'est servi qu'aux navigateurs sans AVIF —
                Safari d'avant 16.4, pour l'essentiel — et une qualité par
                format supposerait d'écrire la balise picture à la main.

                `width` fixe le repli `src` sur la plus grande variante
                déclarée. Sans lui, Astro y met la photo à sa taille d'origine —
                2400 px pour les prises de vue maison, une variante qu'aucun
                navigateur moderne ne télécharge mais que le dépôt et le
                déploiement transportent. */}
            <Picture
              src={r.image}
              alt={r.alt}
              formats={['avif']}
              fallbackFormat="webp"
              quality={60}
              width={1200}
              widths={[500, 800, 1200]}
              sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw"
              loading={i < eager ? 'eager' : 'lazy'}
              class="h-full w-full object-cover"
            />
          </div>
          <figcaption class="p-6">
            <p class="font-display text-[0.62rem] tracking-[0.28em] text-ciel-600 uppercase">
              {r.metier}
            </p>
            <Titre class="mt-2 text-lg leading-snug">{r.titre}</Titre>
            <p class="mt-2 text-sm leading-relaxed text-encre/70">{r.legende}</p>
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>
