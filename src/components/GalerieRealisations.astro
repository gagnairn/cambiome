---
import { Image } from 'astro:assets';
import type { Realisation } from '~/data/realisations';

interface Props {
  items: Realisation[];
  /**
   * Niveau des titres de chantier. Il dépend du titre qui précède la galerie :
   * sur l'accueil elle suit un h2 (« Quelques réalisations ») et ses items
   * sont donc des h3 ; sur la page Réalisations elle suit le h1 de la page et
   * ils remontent en h2. Sans ce réglage, la seconde sauterait un niveau.
   */
  niveau?: 2 | 3;
  /**
   * Combien d'items charger sans attendre le défilement. Zéro par défaut :
   * sur l'accueil la galerie est tout en bas, et trois images chargées d'avance
   * y disputaient la bande passante à celle du hero, qui est l'image que le
   * visiteur regarde. Sur la page Réalisations, où la galerie commence sous le
   * titre, la première rangée mérite le traitement inverse.
   */
  eager?: number;
}

const { items, niveau = 3, eager = 0 } = Astro.props;

const Titre = `h${niveau}` as 'h2' | 'h3';
---

<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    items.map((r, i) => (
      <li class="overflow-hidden rounded-lg border border-sable-200 bg-white">
        <figure>
          <div class="aspect-4/3 overflow-hidden bg-sable-100">
            <Image
              src={r.image}
              alt={r.alt}
              widths={[500, 800, 1200]}
              sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw"
              loading={i < eager ? 'eager' : 'lazy'}
              class="h-full w-full object-cover"
            />
          </div>
          <figcaption class="p-6">
            <p class="font-display text-[0.62rem] tracking-[0.28em] text-ardoise-600 uppercase">
              {r.metier}
            </p>
            <Titre class="mt-2 text-lg leading-snug">{r.titre}</Titre>
            <p class="mt-2 text-sm leading-relaxed text-encre/70">{r.legende}</p>
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>
