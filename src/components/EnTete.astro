---
import { Image } from 'astro:assets';
import marque from '~/assets/logos/derives/marque-noire.png';
import { site } from '~/data/site';
import { lien } from '~/lib/base';

const nav = [
  { href: lien('/metiers'), label: 'Métiers' },
  { href: lien('/demarche'), label: 'Notre démarche' },
  { href: lien('/realisations'), label: 'Réalisations' },
  { href: lien('/contact'), label: 'Contact' },
];

const ici = Astro.url.pathname.replace(/\/$/, '');
const actif = (href: string) => ici === href.replace(/\/$/, '');
---

<header class="sticky top-0 z-40 border-b border-sable-200 bg-sable-50/90 backdrop-blur">
  <div class="container-page flex h-20 items-center justify-between gap-4">
    <a
      href={lien('/')}
      class="flex items-center gap-3"
      aria-label={`${site.nom} — accueil`}
    >
      {/* La marque seule : le nom et la baseline sont juste à droite, en
          texte. `densities` sert les écrans à forte densité — sans lui, une
          image de 44 px est étirée et les cernes se brouillent. */}
      <Image
        src={marque}
        alt=""
        width={44}
        height={44}
        densities={[1, 2, 3]}
        loading="eager"
        class="h-11 w-11"
      />
      <span class="leading-none">
        <span class="block font-display text-xl font-light tracking-[0.22em] text-encre">
          {site.nom}
        </span>
        <span class="mt-1 block font-display text-[0.62rem] tracking-[0.3em] text-ciel-600 uppercase">
          {site.baseline}
        </span>
      </span>
    </a>

    {/* Les deux <nav> de l'en-tête portent des noms distincts. Un seul est
        exposé à la fois — `hidden md:block` et `md:hidden` posent un
        `display:none`, qui retire l'autre de l'arbre d'accessibilité — mais
        deux repères de même nom dans un même document restent une ambiguïté
        pour qui audite le balisage, et les distinguer ne coûte rien. */}
    <nav aria-label="Navigation principale" class="hidden md:block">
      <ul class="flex items-center gap-8">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={actif(item.href) ? 'page' : undefined}
                class:list={[
                  'text-sm transition-colors hover:text-ciel-600',
                  actif(item.href)
                    ? 'text-ciel-700 underline decoration-ciel-400 underline-offset-8'
                    : 'text-encre/75',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* Menu mobile : <details> natif. Le déploiement ne demande aucun JS ;
        la fermeture, si — voir le script en bas de fichier. */}
    <details id="menu-mobile" class="group relative md:hidden">
      <summary
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-sable-300 text-encre [&::-webkit-details-marker]:hidden"
      >
        {/* Le libellé suit l'état du <details>, en CSS seule : un aria-label
            figé annoncerait « Ouvrir » alors que le menu est déjà ouvert. */}
        <span class="sr-only group-open:hidden">Ouvrir le menu</span>
        <span class="sr-only hidden group-open:block">Fermer le menu</span>
        <svg
          class="h-5 w-5 group-open:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
        <svg
          class="hidden h-5 w-5 group-open:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </summary>
      <nav
        aria-label="Menu principal"
        class="absolute right-0 mt-3 w-60 rounded-lg border border-sable-200 bg-sable-50 p-2 shadow-lg shadow-ciel-900/5"
      >
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={actif(item.href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-md px-4 py-3 text-sm hover:bg-sable-100',
                    actif(item.href) ? 'text-ciel-700' : 'text-encre/80',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  /**
   * Fermeture du menu mobile.
   *
   * `<details>` sait s'ouvrir et se fermer sur son propre résumé, et c'est
   * tout : contrairement à `<dialog>` ou à un `popover`, il ignore la touche
   * Échap et les clics à côté. Un menu ouvert reste donc ouvert par-dessus la
   * page tant qu'on ne revient pas précisément sur le bouton — sur mobile,
   * c'est le geste qu'on ne fait pas.
   *
   * `popover` réglerait les deux nativement, mais il place le panneau dans la
   * couche supérieure, hors du flux : il faudrait le repositionner à la main
   * sous un en-tête collant, ou recourir à l'ancrage CSS. Le script qui suit
   * coûte moins cher que cette bascule.
   *
   * Sans JavaScript, le menu s'ouvre et se ferme quand même par son bouton :
   * ce script améliore, il ne fait pas fonctionner.
   */
  const menu = document.querySelector<HTMLDetailsElement>('#menu-mobile');

  if (menu) {
    const fermer = () => {
      if (menu.open) menu.open = false;
    };

    // Clic en dehors. `composedPath` plutôt que `contains` : il traverse les
    // frontières d'arbre, et le résumé contient des SVG.
    document.addEventListener('click', (e) => {
      if (!e.composedPath().includes(menu)) fermer();
    });

    // Échap, et le focus revient au bouton — sinon il retombe sur le <body>
    // et la navigation au clavier repart du haut de la page.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        fermer();
        menu.querySelector('summary')?.focus();
      }
    });

    // Focus sorti du menu par Tab : il est derrière nous, on le referme.
    //
    // `relatedTarget` et non `document.activeElement` : `focusout` part avant
    // que le focus soit posé ailleurs, et à cet instant `activeElement` vaut
    // encore `body`. Interroger `activeElement` refermait donc le menu à la
    // première tabulation — y compris quand le focus allait vers un lien du
    // menu lui-même, qui devenait inatteignable au clavier. `relatedTarget`
    // désigne l'élément qui reçoit le focus, il est exact tout de suite.
    //
    // `relatedTarget` nul veut dire « le focus ne va nulle part », et il ne
    // faut surtout PAS refermer dans ce cas. C'est ce qui arrive sur iOS à
    // chaque fois qu'on touche un lien du menu : WebKit ne donne pas le focus
    // aux liens au doigt, il part donc du résumé vers rien. Le menu se
    // refermait entre le `touchend` et le `click`, le panneau disparaissait,
    // et le clic retombait sur le `<body>` — aucun lien du menu ne
    // fonctionnait sur iPhone ni sur iPad. Le clic à côté est déjà couvert
    // plus haut ; ne reste ici que le vrai déplacement de focus.
    menu.addEventListener('focusout', (e) => {
      const arrivee = e.relatedTarget;
      if (arrivee === null) return;
      if (!(arrivee instanceof Node) || !menu.contains(arrivee)) fermer();
    });
  }
</script>
