---
/**
 * Renvoi vers la page « Entreprise RGE Qualibat ».
 *
 * Posé sur le métier Rénovation thermique, parce que c'est le seul endroit où
 * l'information a une conséquence pour le lecteur : sans entreprise RGE, pas
 * de MaPrimeRénov' ni de CEE, donc un reste à charge entier.
 *
 * Deux lignes et un lien, là où l'encadré développait auparavant les aides,
 * les quatre domaines qualifiés et le numéro de certificat au beau milieu de
 * la page Métiers. Tout cela vit désormais sur sa propre page, où il ne coupe
 * plus la lecture des savoir-faire et où il y a la place de l'expliquer.
 *
 * Rendu sans condition. Le renvoi se retirait auparavant de lui-même passée
 * l'échéance de la qualification ; cette règle a été supprimée du dépôt — voir
 * le bloc RGE de `src/data/site.ts`.
 */
import { renvoiRge } from '~/data/pages';
import { lien } from '~/lib/base';
---

<a
  href={lien('/rge-qualibat')}
  class="group mt-10 block rounded-lg border border-ciel-200 bg-ciel-50 p-5 transition-colors hover:border-ciel-300"
>
  <span class="block font-display text-sm tracking-[0.18em] text-ciel-700 uppercase">
    {renvoiRge.surtitre}
  </span>
  <span class="mt-2 block text-sm leading-relaxed text-encre/75">
    {renvoiRge.texte}{' '}
    <span class="text-ciel-700 underline-offset-4 group-hover:underline">
      {renvoiRge.lien}
    </span>
  </span>
</a>
