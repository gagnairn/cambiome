---
import { contact, site } from '~/data/site';
import { lien } from '~/lib/base';
import { telephoneInsecable } from '~/lib/texte';

/**
 * Formulaire de contact.
 *
 * Le site est statique : c'est Web3Forms (https://web3forms.com) qui reçoit la
 * requête et la réexpédie par email à CAMBIOME. La clé d'accès vit dans
 * `contact.web3formsCle` ; sans elle, ce composant ne rend rien.
 *
 * L'envoi se fait en fetch pour rester sur la page, mais le formulaire reste un
 * vrai <form> POST : sans JavaScript, le navigateur poste directement vers
 * Web3Forms, qui renvoie ensuite sur la page /merci (champ `redirect`).
 *
 * Deux conventions de Web3Forms commandent le nommage des champs ci-dessous :
 *
 * — les noms réservés (`access_key`, `subject`, `from_name`, `redirect`,
 *   `replyto`, `botcheck`) pilotent le service et ne ressortent pas dans le
 *   message ; tous les autres sont recopiés dans l'e-mail reçu, avec leur nom
 *   pour intitulé. D'où « Commune du chantier » plutôt que `commune` : c'est
 *   une étiquette lue par CAMBIOME, pas un identifiant de code ;
 * — le champ nommé exactement `email` devient l'adresse de réponse. Répondre
 *   au message reçu écrit donc à la personne, sans copier-coller. C'est la
 *   raison pour laquelle celui-là seul garde un nom en minuscules.
 */
const ENDPOINT = 'https://api.web3forms.com/submit';

const urlMerci = new URL(lien('/merci'), Astro.site).href;

// Message d'échec : on n'oriente vers un moyen de contact direct que s'il est
// effectivement renseigné dans `site.ts`.
const messageErreur = contact.email
  ? `L'envoi a échoué. Réessayez dans un instant, ou écrivez-nous directement à ${contact.email}.`
  : contact.telephone
    ? `L'envoi a échoué. Réessayez dans un instant, ou appelez-nous au ${telephoneInsecable(contact.telephone)}.`
    : "L'envoi a échoué. Réessayez dans un instant.";

// `sable-500` et non `sable-300` : le contour d'un champ de saisie est ce qui
// identifie la commande, WCAG 1.4.11 lui demande 3:1 sur le fond. Le 300 n'en
// donnait que 1,60. Même raison pour le texte indicatif, remonté de 35 % à
// 65 % d'opacité — il était à 2,17:1.
const champ =
  'mt-2 w-full rounded-md border border-sable-500 bg-white px-4 py-3 text-sm placeholder:text-encre/65 focus:border-ardoise-500';
const label = 'block text-sm text-encre/80';
---

{
  contact.web3formsCle ? (
    <div class="max-w-xl">
      {/* Panneau de confirmation — dévoilé par le script après un envoi réussi */}
      <div
        id="contact-succes"
        tabindex="-1"
        hidden
        class="rounded-lg border border-ardoise-200 bg-ardoise-50 p-8"
      >
        <h2 class="text-xl">Message envoyé.</h2>
        <p class="mt-4 text-sm leading-relaxed text-encre/75">
          Merci, nous avons bien reçu votre demande et vous répondrons sous
          quelques jours ouvrés. Si le sujet est urgent, le téléphone reste le
          plus sûr.
        </p>
      </div>

      <form
        id="contact-formulaire"
        action={ENDPOINT}
        method="POST"
        data-message-erreur={messageErreur}
        data-sujet={`${site.nom} — demande`}
      >
        {/* Champs de service Web3Forms */}
        <input type="hidden" name="access_key" value={contact.web3formsCle} />
        {/* Sujet de repli, utilisé tel quel sans JavaScript. Avec JavaScript,
            le script le complète du nom et de la commune : voir plus bas. */}
        <input
          type="hidden"
          name="subject"
          value={`${site.nom} — nouvelle demande depuis le site`}
        />
        <input type="hidden" name="from_name" value={`Site ${site.nom}`} />
        {/* Retour après envoi quand JavaScript est indisponible */}
        <input type="hidden" name="redirect" value={urlMerci} />

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label class={label} for="nom">
              Nom <span aria-hidden="true">*</span>
            </label>
            <input
              class={champ}
              id="nom"
              name="Nom"
              type="text"
              required
              autocomplete="name"
            />
          </div>
          <div>
            <label class={label} for="email">
              Email <span aria-hidden="true">*</span>
            </label>
            <input
              class={champ}
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
            />
          </div>
          <div>
            <label class={label} for="telephone">
              Téléphone
            </label>
            <input
              class={champ}
              id="telephone"
              name="Téléphone"
              type="tel"
              autocomplete="tel"
            />
          </div>
          <div>
            <label class={label} for="commune">
              Commune du chantier
            </label>
            <input
              class={champ}
              id="commune"
              name="Commune du chantier"
              type="text"
              autocomplete="address-level2"
            />
          </div>
        </div>

        <div class="mt-6">
          <label class={label} for="nature">
            Nature du projet
          </label>
          <select class={champ} id="nature" name="Nature du projet">
            {/* Option vide en tête, et sélectionnée. Sans elle le champ part
                sur « Charpente / ossature bois » : qui ne touche pas au menu
                envoie une qualification qu'il n'a pas choisie, et CAMBIOME
                reçoit une nature de projet fausse. Le champ n'est pas requis,
                une valeur vide est donc un état légitime. */}
            <option value="">— Sélectionnez —</option>
            <option>Charpente / ossature bois</option>
            <option>Rénovation thermique</option>
            <option>Couverture / zinguerie</option>
            <option>Structure bois / menuiserie</option>
            <option>Autre — je précise ci-dessous</option>
          </select>
        </div>

        <div class="mt-6">
          <label class={label} for="message">
            Votre projet <span aria-hidden="true">*</span>
          </label>
          <textarea
            class={champ}
            id="message"
            name="Message"
            rows="6"
            required
            placeholder="Type de bâtiment, surface, travaux envisagés, échéance…"
          />
        </div>

        {/* Piège à robots Web3Forms : masqué aux humains, coché par les bots */}
        <div class="hidden" aria-hidden="true">
          <label for="botcheck">Ne pas remplir</label>
          {/* Pas d'`autocomplete` : l'attribut n'est pas autorisé sur une case
              à cocher, et html-validate le refuse. Il n'y servait de toute
              façon à rien — le remplissage automatique ne coche pas les cases
              d'un formulaire. */}
          <input id="botcheck" name="botcheck" type="checkbox" tabindex="-1" />
        </div>

        <div class="mt-8 flex gap-3">
          <input
            id="consentement"
            name="Consentement"
            type="checkbox"
            value="accordé"
            required
            class="mt-1 size-4 shrink-0 accent-ardoise-600"
          />
          {/* Le lien est volontairement HORS du <label>. Imbriqué, un clic
              dessus suit le lien et coche la case au passage, selon le
              navigateur — la personne accepte sans l'avoir voulu, sur la
              case même qui recueille son consentement. Son intitulé nomme
              aussi sa destination : « en savoir plus » ne dit rien dans la
              liste des liens d'un lecteur d'écran. */}
          <div class="text-xs leading-relaxed text-encre/65">
            <label for="consentement">
              J'accepte que ces informations soient transmises à CAMBIOME et à
              son prestataire d'envoi pour répondre à ma demande. Elles ne sont
              ni cédées ni utilisées à des fins commerciales.{' '}
              <span aria-hidden="true">*</span>
            </label>{' '}
            <a class="underline underline-offset-2" href={lien('/mentions-legales')}>
              Mentions légales
            </a>
          </div>
        </div>

        <button
          type="submit"
          class="mt-8 inline-flex rounded-full border border-marque-bord bg-marque px-8 py-3 text-sm tracking-wide text-sur-marque transition-colors hover:bg-marque-survol disabled:cursor-not-allowed disabled:opacity-60"
        >
          Envoyer
        </button>

        {/* Région d'annonce : vide, elle ne s'affiche pas (variante `empty:`) */}
        <p
          id="contact-statut"
          role="status"
          aria-live="polite"
          class="mt-5 text-sm leading-relaxed text-encre/70 empty:hidden data-[etat=erreur]:text-terre-700"
        />
      </form>
    </div>
  ) : (
    <div class="max-w-xl rounded-lg border border-dashed border-sable-300 bg-sable-100 p-8">
      <h2 class="text-xl">Formulaire à activer</h2>
      <p class="mt-4 text-sm leading-relaxed text-encre/70">
        Le site est statique : pour recevoir les messages, il faut une clé
        Web3Forms. Indiquez l'adresse de réception sur{' '}
        <a class="underline underline-offset-2" href="https://web3forms.com">
          web3forms.com
        </a>
        , validez le mail de confirmation, puis collez la clé obtenue dans le
        CMS, entrée « Entreprise », champ « Clé Web3Forms ». Le formulaire
        complet s'affichera alors ici.
      </p>
    </div>
  )
}

<script>
  const formulaire = document.querySelector<HTMLFormElement>('#contact-formulaire');
  const succes = document.querySelector<HTMLElement>('#contact-succes');
  const statut = document.querySelector<HTMLElement>('#contact-statut');

  // Sans le formulaire (clé absente), il n'y a rien à brancher.
  if (formulaire && succes && statut) {
    const bouton = formulaire.querySelector<HTMLButtonElement>('button[type="submit"]');

    const annoncer = (texte: string, etat?: 'erreur') => {
      statut.textContent = texte;
      if (etat) statut.dataset.etat = etat;
      else delete statut.dataset.etat;
    };

    const rendreLaMain = () => {
      if (!bouton) return;
      bouton.disabled = false;
      bouton.textContent = 'Envoyer';
    };

    /**
     * Sujet de l'e-mail reçu par CAMBIOME. Le champ caché `subject` porte un
     * libellé fixe, qui sert quand ce script ne tourne pas ; ici on peut dire
     * mieux : qui écrit, et d'où. Une boîte de réception se trie alors d'un
     * coup d'œil, au lieu d'aligner vingt fois la même ligne.
     */
    const sujet = (donnees: Record<string, unknown>) => {
      const base = formulaire.dataset.sujet;
      const qui = String(donnees['Nom'] ?? '').trim();
      if (!base || !qui) return donnees.subject;

      const ou = String(donnees['Commune du chantier'] ?? '').trim();
      return `${base} de ${qui}${ou ? ` (${ou})` : ''}`;
    };

    formulaire.addEventListener('submit', async (evenement) => {
      // La validation native a déjà eu lieu : `submit` ne part que si le
      // formulaire est valide.
      evenement.preventDefault();

      if (bouton) {
        bouton.disabled = true;
        bouton.textContent = 'Envoi…';
      }
      annoncer('Envoi en cours…');

      try {
        const donnees = Object.fromEntries(new FormData(formulaire));
        donnees.subject = sujet(donnees) as FormDataEntryValue;

        const reponse = await fetch(formulaire.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(donnees),
        });

        // 429 : Web3Forms limite la cadence des envois. Ce n'est pas une
        // panne, et le message générique — « réessayez dans un instant » —
        // ferait recommencer aussitôt, donc échouer encore. On dit le délai,
        // et on ne propose pas le téléphone pour ce qui se résout en attendant.
        if (reponse.status === 429) {
          annoncer(
            'Trop de messages envoyés coup sur coup. Patientez une minute, puis réessayez : votre texte est conservé.',
            'erreur'
          );
          rendreLaMain();
          return;
        }

        const resultat = await reponse.json();

        if (!reponse.ok || !resultat.success) {
          throw new Error(resultat.message ?? `HTTP ${reponse.status}`);
        }

        annoncer('');
        formulaire.hidden = true;
        succes.hidden = false;
        succes.focus();
      } catch (erreur) {
        console.error("Échec de l'envoi du formulaire de contact", erreur);
        annoncer(
          formulaire.dataset.messageErreur ?? "L'envoi a échoué. Réessayez dans un instant.",
          'erreur'
        );
        rendreLaMain();
      }
    });
  }
</script>
