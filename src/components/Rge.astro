---
/**
 * Bloc « Reconnu Garant de l'Environnement ».
 *
 * Placé sur le métier Rénovation thermique, parce que c'est le seul endroit où
 * l'information a une conséquence pour le lecteur : sans entreprise RGE, pas
 * de MaPrimeRénov' ni de CEE, donc un reste à charge entier.
 *
 * Ne rend rien si la qualification est expirée — l'afficher au-delà de sa date
 * de fin serait une allégation trompeuse au sens du code de la consommation.
 */
import { rge, rgeEnCours } from '~/data/site';

const finLisible = new Date(rge.fin).toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

{
  rgeEnCours && (
    <aside class="mt-10 rounded-lg border border-ardoise-200 bg-ardoise-50 p-6">
      <p class="font-display text-sm tracking-[0.18em] text-ardoise-700 uppercase">
        Entreprise RGE {rge.organisme}
      </p>
      <p class="mt-3 leading-relaxed text-encre/80">
        Nos chantiers d'isolation ouvrent droit à <strong class="font-medium">MaPrimeRénov'</strong>
        {' '}et aux <strong class="font-medium">certificats d'économies d'énergie</strong>. Ces
        aides sont réservées aux travaux réalisés par une entreprise qualifiée
        RGE : c'est cette qualification qui les rend accessibles.
      </p>

      <p class="mt-5 text-xs tracking-[0.16em] text-encre/55 uppercase">
        Domaines qualifiés
      </p>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {rge.domaines.map((d) => (
          <li class="flex gap-2.5 text-sm text-encre/75">
            <svg
              class="mt-1 h-3.5 w-3.5 shrink-0 text-ardoise-500"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="m5 12.5 4.5 4.5L19 7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>{d}</span>
          </li>
        ))}
      </ul>

      <p class="mt-5 text-xs leading-relaxed text-encre/55">
        {rge.certificat}, valable jusqu'au {finLisible}.{' '}
        <a
          class="underline underline-offset-4 hover:text-ardoise-700"
          href={rge.attestation}
          rel="noopener"
        >
          Consulter l'attestation
        </a>{' '}
        (PDF).
      </p>
    </aside>
  )
}
