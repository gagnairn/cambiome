---
import { Image } from 'astro:assets';
import marque from '~/assets/logos/marque-noire.png';
import logoRge from '~/assets/logos/rge-qualibat.png';
import logoRfcp from '~/assets/logos/rfcp.png';
import { site, contact, metiers, rge } from '~/data/site';
import { lien } from '~/lib/base';
import { telephoneInsecable } from '~/lib/texte';

const annee = 2026; // mise à jour manuelle : le site est statique, pas de JS d'horloge

// Les entrées du bandeau partagent la même classe : colonnes de largeur égale,
// filet de séparation sauf sur la première. Chacune se cale ensuite dans sa
// colonne (à gauche, au centre, à droite) pour occuper toute la largeur du pied
// de page plutôt que de se tasser d'un côté.
// Tout le pied de page tient sur un seul ton de texte, `sur-marque`. La
// contrainte qui l'imposait a disparu avec les pistes à aplat mi-tons, où il
// ne restait pas 4,5:1 de marge pour un second ton ; sur #9DC3D4 l'encre donne
// 9,03:1, et un ton secondaire tiendrait jusqu'à 70 % d'opacité (4,52:1). Si
// la hiérarchie reste portée par la casse, l'interlettrage et la taille, c'est
// désormais un choix et non une obligation — le rappeler évite de rouvrir le
// calcul la prochaine fois que la question se pose.
const entreeBandeau =
  'group flex items-center gap-4 sm:border-l sm:border-sur-marque/25 sm:first:border-l-0';
const titreBandeau = 'block font-display tracking-[0.16em] uppercase';
const lienBandeau = 'block underline-offset-4 group-hover:underline';

// Le nombre de colonnes suit le nombre d'entrées réellement rendues, sans quoi
// une entrée masquée laisserait une colonne vide à droite. Seul Instagram est
// encore masquable : la qualification RGE et le renvoi Pro-Paille sont rendus
// sans condition.
const nbEntrees = 2 + (contact.instagram ? 1 : 0);
const colonnesBandeau = nbEntrees === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2';
---

<footer class="surface-marque mt-24 bg-marque text-sur-marque">
  <div class="container-page grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2 lg:col-span-1">
      {/* Marque seule : le nom et la baseline suivent en texte, juste dessous.
          La version sombre, comme tout ce qui est posé sur l'aplat : la marque
          blanche ne donnerait que 1,88:1 sur #9DC3D4, elle y serait invisible.
          C'est aussi celle qui convient à l'impression, où le fond saute. */}
      <Image
        src={marque}
        alt=""
        width={56}
        height={56}
        densities={[1, 2, 3]}
        class="h-14 w-14"
      />
      <p class="mt-4 font-display text-lg tracking-[0.22em]">
        {site.nom}
      </p>
      <p class="font-display text-[0.62rem] tracking-[0.3em] uppercase">
        {site.baseline}
      </p>
    </div>

    {/* Les deux colonnes de liens sautent à l'impression : sur papier, une
        liste de pages est un cul-de-sac. Voir `@media print` dans global.css. */}
    <div class="impression-masquer">
      <h2 class="text-xs tracking-[0.2em] uppercase">Métiers</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          metiers.map((m) => (
            <li>
              <a
                class="underline-offset-4 hover:underline"
                href={`${lien('/metiers')}#${m.slug}`}
              >
                {m.titre}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="impression-masquer">
      <h2 class="text-xs tracking-[0.2em] uppercase">Le site</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li>
          <a class="underline-offset-4 hover:underline" href={lien('/demarche')}>
            Notre démarche
          </a>
        </li>
        <li>
          <a class="underline-offset-4 hover:underline" href={lien('/realisations')}>
            Réalisations
          </a>
        </li>
        <li>
          <a class="underline-offset-4 hover:underline" href={lien('/contact')}>
            Contact
          </a>
        </li>
        <li>
          <a class="underline-offset-4 hover:underline" href={lien('/mentions-legales')}>
            Mentions légales
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="text-xs tracking-[0.2em] uppercase">Contact</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          contact.telephone && (
            <li>
              <a
                class="underline-offset-4 hover:underline"
                href={`tel:${contact.telephone.replace(/\s/g, '')}`}
              >
                {telephoneInsecable(contact.telephone)}
              </a>
            </li>
          )
        }
        {
          contact.email && (
            <li>
              <a class="underline-offset-4 hover:underline" href={`mailto:${contact.email}`}>
                {contact.email}
              </a>
            </li>
          )
        }
        {/* La colonne est étroite : l'adresse se coupe après la voie plutôt
            que de retomber au hasard de la largeur. La donnée reste sur une
            ligne — les mentions légales, elles, la veulent d'un tenant. */}
        {
          contact.adresseVisible && (
            <li class="whitespace-pre-line">
              {contact.adresseVisible.replace(/,\s*/, ',\n')}
            </li>
          )
        }
        {
          !contact.telephone && !contact.email && (
            <li>
              <a class="underline-offset-4 hover:underline" href={lien('/contact')}>
                Nous écrire
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>

  {/* Bandeau des qualifications, à la place de la liste des métiers qui
      recopiait la colonne juste au-dessus. Deux mentions vérifiables, chacune
      renvoyant à sa preuve : l'attestation Qualibat et la formation Pro-Paille.

      Les deux logos sont posés sur la même pastille blanche à filet. Pour
      Qualibat, sa charte l'impose sur fond clair et il est lui-même sur fond
      blanc ; pour le RFCP, le disque orange ne donne que 1,21:1 sur l'aplat de
      marque, son bord s'y évanouirait. Même remède, et les deux entrées se
      répondent.

      Grille plutôt que rangée flex : à trois entrées de largeurs très
      inégales, le flex les tassait à gauche en laissant un vide à droite, et
      la bande ne se calait plus sur les colonnes du dessus. Des colonnes
      égales suffisent à la remettre d'aplomb. */}
  <div class="border-t border-sur-marque/25">
    <div
      class:list={[
        'container-page grid gap-y-7 py-8 sm:gap-x-8',
        colonnesBandeau,
      ]}
    >
      <a class={entreeBandeau} href={lien('/rge-qualibat')}>
        {/* Filet sur la pastille : le fond blanc qu'impose la charte
            Qualibat ne donne que 1,88:1 sur l'aplat de marque, la plaque
            s'y évanouit. Le logo lui-même reste lisible (il est sur
            blanc) et les logos échappent aux seuils de contraste, mais un
            cerne suffit à ce que la plaque se lise comme un choix. */}
        <span class="shrink-0 rounded-md border border-encre/10 bg-white p-1.5">
          <Image src={logoRge} alt="" width={44} densities={[1, 2]} class="w-11" />
        </span>
        {/* Titre court : sur une colonne au tiers de la largeur,
            « Reconnu Garant de l'Environnement » passait à la ligne et
            déséquilibrait la rangée. L'intitulé complet est sur la page
            dédiée, où mène ce lien — il visait auparavant le PDF de
            l'attestation, qui se téléchargeait sans prévenir. */}
        <span class="text-xs leading-relaxed">
          <span class={titreBandeau}>Qualification RGE</span>
          <span class={lienBandeau}>{rge.certificat}</span>
        </span>
      </a>

      {/* Pro-Paille n'a pas de page ici — le lien sort donc vers le RFCP, qui
          décrit la formation et publie les règles. C'est la seule preuve
          consultable tant que l'attestation n'est pas versée au dépôt : une
          mention de certification sans destination vérifiable, à côté d'une
          entrée RGE qui porte son numéro de certificat, se lirait comme une
          allégation. Le titre est court (« Certification » seul) :
          « Certification Pro-Paille » en capitales interlettrées passe à la
          ligne sur une colonne au tiers de la largeur, comme l'intitulé RGE
          complet juste avant. */}
      <a
        class:list={[entreeBandeau, 'sm:justify-center sm:text-center']}
        href="https://www.rfcp.fr/propaille/"
        rel="noopener"
      >
        {/* C'est le logo du réseau, pas une marque de certification : le RFCP
            délivre une attestation de réussite à Pro-Paille, pas un droit
            d'usage d'emblème. Il est donc porté par le lien qui mène au RFCP,
            où la formation est décrite — il désigne l'organisme, il ne
            prétend pas labelliser l'entreprise. */}
        <span class="shrink-0 rounded-md border border-encre/10 bg-white p-1.5">
          <Image src={logoRfcp} alt="" width={44} densities={[1, 2]} class="w-11" />
        </span>
        <span class="text-xs leading-relaxed">
          <span class={titreBandeau}>Certification</span>
          <span class={lienBandeau}>Pro-Paille, règles CP 2012</span>
        </span>
      </a>

      {
        contact.instagram && (
          <a
            class:list={[entreeBandeau, 'sm:justify-end sm:text-right']}
            href={contact.instagram}
            rel="me noopener"
          >
            <span class="text-xs leading-relaxed">
              <span class={titreBandeau}>Portfolio</span>
              {/* « Instagram » est écrit en toutes lettres : sans cela, on
                  attendrait la page Réalisations plutôt qu'un site tiers. */}
              <span class={lienBandeau}>Nos chantiers sur Instagram</span>
            </span>
          </a>
        )
      }
    </div>
  </div>

  <div class="border-t border-sur-marque/25">
    <div class="container-page py-6 text-center text-xs">
      <p>© {annee} {site.nom}. Tous droits réservés.</p>
    </div>
  </div>
</footer>
