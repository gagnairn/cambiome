---
import { Image } from 'astro:assets';
import MotifCernes from '~/components/MotifCernes.astro';
import type { Metier } from '~/data/site';
import { realisations } from '~/data/realisations';
import { base } from '~/lib/base';

interface Props {
  metier: Metier;
  index: number;
}

const { metier, index } = Astro.props;

const illustration = realisations.find((r) => r.metierSlug === metier.slug);
---

<a
  href={`${base}/metiers#${metier.slug}`}
  class="group flex flex-col overflow-hidden rounded-lg border border-sable-200 bg-white transition-shadow hover:shadow-lg hover:shadow-ardoise-900/5"
>
  {
    illustration ? (
      <div class="aspect-4/3 overflow-hidden bg-sable-100">
        <Image
          src={illustration.image}
          alt=""
          widths={[400, 700, 900]}
          sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 90vw"
          loading={index < 2 ? 'eager' : 'lazy'}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      </div>
    ) : (
      <MotifCernes class="aspect-4/3" />
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl leading-snug">{metier.titre}</h3>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-encre/70">{metier.chapo}</p>
    <span
      class="mt-5 inline-flex items-center gap-2 text-sm text-ardoise-700 group-hover:gap-3 motion-safe:transition-all"
    >
      En savoir plus
      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </div>
</a>
