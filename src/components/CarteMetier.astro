---
import { Picture } from 'astro:assets';
import MotifCernes from '~/components/MotifCernes.astro';
import type { Metier } from '~/data/site';
import { realisations, type Realisation } from '~/data/realisations';
import { lien } from '~/lib/base';

interface Props {
  metier: Metier;
  /**
   * Chantiers déjà montrés ailleurs sur la même page. La carte prend le premier
   * de son métier qui n'y figure pas : sinon, la galerie de l'accueil et les
   * vignettes au-dessus d'elle affichent deux fois les mêmes photos, la
   * première entrée de la liste étant à la fois en tête de galerie et, par
   * construction, la première de son métier.
   */
  evite?: Realisation[];
}

const { metier, evite = [] } = Astro.props;

// Le repli sur `siens[0]` vaut pour un métier dont tous les chantiers sont déjà
// en galerie — aujourd'hui la rénovation thermique, qui n'a qu'une photo. Mieux
// vaut la répéter que laisser un motif abstrait à la place d'un ouvrage.
const siens = realisations.filter((r) => r.metierSlug === metier.slug);
const illustration = siens.find((r) => !evite.includes(r)) ?? siens[0];
---

<a
  href={`${lien('/metiers')}#${metier.slug}`}
  class="group flex flex-col overflow-hidden rounded-lg border border-sable-200 bg-white transition-shadow hover:shadow-lg hover:shadow-ciel-900/5"
>
  {
    illustration ? (
      <div class="aspect-4/3 overflow-hidden bg-sable-100">
        {/* `widths`, `formats` et `quality` : les mêmes que
            GalerieRealisations, qui porte le raisonnement sur le format. C'est
            ce qui fait que les deux composants demandent le même fichier :
            `evite` écarte le plus souvent la photo déjà en galerie, mais pas
            dans le cas de repli ci-dessus, et un seul réglage qui diverge la
            ferait télécharger deux fois.

            `loading` : toutes en `lazy`, les cartes étant sous la ligne de
            flottaison y compris sur grand écran. Les deux premières étaient
            chargées d'avance et prenaient la bande passante du hero.

            `width` : fixe le repli `src` sur la plus grande variante déclarée,
            au lieu de la photo à sa taille d'origine — voir
            GalerieRealisations.astro. */}
        <Picture
          src={illustration.image}
          alt=""
          formats={['avif']}
          fallbackFormat="webp"
          quality={60}
          width={1200}
          widths={[500, 800, 1200]}
          sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 90vw"
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      </div>
    ) : (
      <MotifCernes class="aspect-4/3" />
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl leading-snug">{metier.titre}</h3>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-encre/70">{metier.chapo}</p>
    <span
      class="mt-5 inline-flex items-center gap-2 text-sm text-ciel-700 group-hover:gap-3 motion-safe:transition-all"
    >
      En savoir plus
      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </div>
</a>
