---
import '~/styles/global.css';
import DonneesStructurees from '~/components/DonneesStructurees.astro';
import EnTete from '~/components/EnTete.astro';
import PiedDePage from '~/components/PiedDePage.astro';
import SelecteurTheme from '~/components/SelecteurTheme.astro';
import { site, themes } from '~/data/site';
import { lien } from '~/lib/base';
import { SCRIPT_THEME } from '~/lib/theme-script';

// Les deux sous-ensembles latins, les seuls qu'un texte français télécharge —
// les autres (cyrillique, grec, vietnamien) sont déclarés avec leur
// `unicode-range` et ne partent jamais. Importés en `?url` pour obtenir le nom
// haché que Vite leur donne au build : l'écrire à la main le figerait, et le
// préchargement pointerait dans le vide au prochain build.
import policeTexte from '~/assets/polices/inter-400-700.woff2?url';
import policeTitres from '~/assets/polices/jost-300-400.woff2?url';

interface Props {
  titre: string;
  description?: string;
  /** Ajoute une classe au <main>, ex. pour un hero pleine largeur */
  mainClass?: string;
  /** Retire la page des moteurs de recherche (ex. page de confirmation) */
  noindex?: boolean;
}

const {
  titre,
  description = site.description,
  mainClass = '',
  noindex = false,
} = Astro.props;

const titreComplet =
  titre === 'accueil'
    ? `${site.nom} — ${site.accroche}`
    : `${titre} — ${site.nom}`;

const canonical = new URL(Astro.url.pathname, Astro.site);

/**
 * Préversion : le site est servi depuis GitHub Pages, à une adresse qui n'est
 * pas la sienne. La laisser indexer coûterait cher au moment de la bascule —
 * les pages de la marque installées sous un sous-domaine personnel, puis deux
 * adresses servant le même contenu, sans possibilité de rediriger : GitHub
 * Pages est un hébergeur statique, il ne sait pas émettre de 301.
 *
 * Déduit du nom d'hôte et non d'un drapeau à part : la balise disparaît d'elle-
 * même le jour où `HEBERGEMENT` passe en production dans astro.config.mjs. Il
 * n'y a rien à penser à retirer, donc rien à oublier.
 *
 * `noindex` plutôt qu'un `Disallow` dans robots.txt : interdire l'exploration
 * empêcherait justement de lire cette balise, et l'adresse pourrait malgré
 * tout ressortir dans les résultats, sans description. Ici on laisse explorer
 * et on demande à ne pas indexer, ce qui est la seule combinaison qui tient.
 */
const preversion = Astro.site?.hostname.endsWith('github.io') ?? false;
const horsIndex = noindex || preversion;

// Les réseaux sociaux exigent une URL absolue : un chemin relatif est ignoré
// et la carte de partage reste vide.
const ogImage = new URL(lien('/og-image.jpg'), Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* Restauration de la piste chromatique choisie — DISPOSITIF TEMPORAIRE,
         voir `themes` dans src/data/site.ts. En tête de <head> et `is:inline`
         à dessein : un script groupé est différé, la page s'afficherait donc
         en ardoise avant de virer, à chaque navigation. `set:html` plutôt que
         du texte entre balises : dans un script `is:inline`, Astro n'évalue
         pas les accolades et écrirait l'expression telle quelle. Le hachage
         CSP est dérivé de la même chaîne dans astro.config.mjs. */
      themes.selecteur && <script is:inline set:html={SCRIPT_THEME} />
    }
    {/* Préchargement des polices. Sans lui, le navigateur ne découvre les
        `woff2` qu'après avoir analysé la feuille de style : le texte s'affiche
        d'abord dans la police de repli, puis saute quand la vraie arrive.
        Mesuré sur la page Métiers sous bridage mobile — décalage cumulé de
        0,094, au-dessus du seuil de 0,1 quand Lighthouse le mesure ; 0,000 en
        empêchant les polices de se charger, ce qui désigne bien le coupable.
        `crossorigin` est obligatoire même pour une police du même domaine :
        les requêtes de police sont anonymes, et sans lui le navigateur
        téléchargerait le fichier deux fois. */}
    <link rel="preload" as="font" type="font/woff2" href={policeTexte} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={policeTitres} crossorigin />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <DonneesStructurees />
    {/* Pas de canonique sur une page volontairement hors index : elle ne
        demande pas à être indexée, l'adresse de référence n'a donc rien à
        désigner. Sur la 404 la balise était même fausse — elle pointait vers
        /404/, qui n'existe pas. La canonique reste en revanche en préversion :
        elle désigne alors l'adresse réellement servie, et sera juste telle
        quelle une fois le domaine posé. `og:url` la garde de toute façon : les
        réseaux sociaux s'en servent pour identifier ce qui est partagé,
        indépendamment de l'indexation. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {horsIndex && <meta name="robots" content="noindex, follow" />}
    {/* Icônes : le .ico couvre les onglets (16/32/48), l'apple-touch-icon
        l'ajout à l'écran d'accueil iOS, le manifeste Android. Pas de favicon
        SVG : le logo n'existe qu'en raster, un SVG serait un redessin qui ne
        correspondrait plus à la marque. Générés par `npm run images`. */}
    <link rel="icon" href={lien('/favicon.ico')} sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href={lien('/apple-touch-icon.png')} />
    <link rel="manifest" href={lien('/site.webmanifest')} />
    <meta name="theme-color" content="#41738D" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`Charpente en cours de montage — ${site.nom}, ${site.baseline}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-ardoise-700 focus:px-5 focus:py-2 focus:text-sm focus:text-white"
    >
      Aller au contenu
    </a>

    <EnTete />

    <main id="contenu" class={`flex-1 ${mainClass}`}>
      <slot />
    </main>

    <PiedDePage />

    {themes.selecteur && <SelecteurTheme />}
  </body>
</html>
