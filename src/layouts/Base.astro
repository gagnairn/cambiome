---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { site } from '~/data/site';
import { base } from '~/lib/base';

interface Props {
  titre: string;
  description?: string;
  /** Ajoute une classe au <main>, ex. pour un hero pleine largeur */
  mainClass?: string;
  /** Retire la page des moteurs de recherche (ex. page de confirmation) */
  noindex?: boolean;
}

const {
  titre,
  description = site.description,
  mainClass = '',
  noindex = false,
} = Astro.props;

const titreComplet =
  titre === 'accueil'
    ? `${site.nom} — ${site.accroche}`
    : `${titre} — ${site.nom}`;

const canonical = new URL(Astro.url.pathname, Astro.site);

// Les réseaux sociaux exigent une URL absolue : un chemin relatif est ignoré
// et la carte de partage reste vide.
const ogImage = new URL(`${base}/og-image.jpg`, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {/* Icônes : le .ico couvre les onglets (16/32/48), l'apple-touch-icon
        l'ajout à l'écran d'accueil iOS, le manifeste Android. Pas de favicon
        SVG : le logo n'existe qu'en raster, un SVG serait un redessin qui ne
        correspondrait plus à la marque. Générés par `npm run images`. */}
    <link rel="icon" href={`${base}/favicon.ico`} sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta name="theme-color" content="#41738D" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`Charpente en cours de montage — ${site.nom}, ${site.baseline}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-ardoise-700 focus:px-5 focus:py-2 focus:text-sm focus:text-white"
    >
      Aller au contenu
    </a>

    <Header />

    <main id="contenu" class={`flex-1 ${mainClass}`}>
      <slot />
    </main>

    <Footer />
  </body>
</html>
