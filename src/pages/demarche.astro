---
import { Picture } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import TitreSection from '~/components/TitreSection.astro';
import AppelContact from '~/components/AppelContact.astro';
import { demarche } from '~/data/site';
import { pageDemarche } from '~/data/pages';
import solivage from '~/assets/realisations/solivage-queue-daronde.jpg';
import chene from '~/assets/realisations/charpente-chene.jpg';
---

<Base titre={pageDemarche.titreOnglet} description={pageDemarche.description}>
  <section class="container-page pt-16">
    <TitreSection niveau={1} surtitre={pageDemarche.surtitre} titre={pageDemarche.titre}>
      <p>{pageDemarche.texte}</p>
    </TitreSection>
  </section>

  <section class="container-page mt-16">
    <div class="grid gap-12 lg:grid-cols-[1fr_auto] lg:gap-16">
      <ol class="space-y-12">
        {
          demarche.map((d, i) => (
            <li class="border-t border-sable-300 pt-7">
              <span class="font-display text-sm text-ciel-600">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h2 class="mt-2 text-2xl leading-snug">{d.titre}</h2>
              <p class="mt-4 max-w-2xl leading-relaxed text-encre/75">{d.texte}</p>
            </li>
          ))
        }
      </ol>

      <div class="hidden w-72 shrink-0 lg:block">
        {/* AVIF avec repli WebP, et `width` pour que le repli `src` se pose sur
            la plus grande variante déclarée plutôt que sur la photo pleine
            taille. Réglé comme la galerie, qui porte le raisonnement : voir
            GalerieRealisations.astro. */}
        <Picture
          src={solivage}
          alt="Comble ancien aux murs de pierre, solives neuves en bois clair posées sous une charpente d'origine."
          formats={['avif']}
          fallbackFormat="webp"
          quality={60}
          width={600}
          widths={[300, 600]}
          sizes="288px"
          loading="lazy"
          class="sticky top-28 aspect-3/4 w-full rounded-lg object-cover"
        />
      </div>
    </div>
  </section>

  <section class="mt-24 bg-sable-100 py-24">
    <div class="container-page grid items-center gap-12 lg:grid-cols-2">
      <div class="overflow-hidden rounded-lg bg-sable-200">
        {/* AVIF avec repli WebP, et `width` pour que le repli `src` se pose sur
            la plus grande variante déclarée plutôt que sur la photo pleine
            taille. Réglé comme la galerie, qui porte le raisonnement : voir
            GalerieRealisations.astro. */}
        <Picture
          src={chene}
          alt="Deux tasses à café émaillées posées sur une poutre de chêne fraîchement taillée."
          formats={['avif']}
          fallbackFormat="webp"
          quality={60}
          width={1400}
          widths={[600, 900, 1400]}
          sizes="(min-width: 1024px) 560px, 92vw"
          loading="lazy"
          class="aspect-4/3 w-full object-cover"
        />
      </div>
      <div>
        <TitreSection
          surtitre={pageDemarche.collaboration.surtitre}
          titre={pageDemarche.collaboration.titre}
          niveau={2}
        />
        {/* Le premier paragraphe se décolle davantage du titre que les
            suivants ne se décollent entre eux. */}
        {
          pageDemarche.collaboration.texte.map((p, i) => (
            <p class:list={[i === 0 ? 'mt-6' : 'mt-4', 'leading-relaxed text-encre/75']}>
              {p}
            </p>
          ))
        }
      </div>
    </div>
  </section>

  <AppelContact />
</Base>
