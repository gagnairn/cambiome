---
import Base from '~/layouts/Base.astro';
import Bouton from '~/components/Bouton.astro';
import { contact } from '~/data/site';
import { pageMerci } from '~/data/pages';
import { lien } from '~/lib/base';
import { telephoneInsecable } from '~/lib/texte';

// Page d'arrivée après un envoi du formulaire sans JavaScript : Web3Forms y
// renvoie via le champ `redirect`. Avec JavaScript, la confirmation s'affiche
// directement sur /contact et cette page n'est jamais atteinte.
---

<Base
  titre={pageMerci.titreOnglet}
  description={pageMerci.description}
  noindex
>
  <section class="container-page flex min-h-[55vh] flex-col justify-center py-24">
    <p class="surtitre">
      {pageMerci.surtitre}
    </p>
    <h1 class="mt-4 text-4xl leading-tight sm:text-5xl">{pageMerci.titre}</h1>
    <div class="rule-cernes mt-6 h-px w-24"></div>
    <p class="mt-6 max-w-md leading-relaxed text-encre/75">
      {pageMerci.texte}{' '}
      {contact.telephone ? pageMerci.urgence : ''}
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <Bouton href={lien('/')}>{pageMerci.bouton}</Bouton>
      {
        contact.telephone && (
          <Bouton href={`tel:${contact.telephone.replace(/\s/g, '')}`} variante="contour">
            {telephoneInsecable(contact.telephone)}
          </Bouton>
        )
      }
    </div>
  </section>
</Base>
