---
import Base from '~/layouts/Base.astro';
import TitreSection from '~/components/TitreSection.astro';
import { site, contact, hebergeur, rge, rgeEnCours } from '~/data/site';
import { telephoneInsecable } from '~/lib/texte';

const aRemplir = (v: string) => v || '⚠ à compléter';

// Le bandeau d'avertissement ne s'affiche que s'il reste effectivement quelque
// chose à renseigner : une alerte qui survit à sa cause finit par être lue
// comme un élément de décor.
const manquants = [
  contact.email,
  contact.adresse,
  contact.capital,
  contact.rcs,
  contact.tva,
  contact.directeurPublication,
  contact.assurance.assureur,
].filter((v) => !v).length;

// « SASU au capital de 5 000 € », ou la forme seule tant que le capital manque.
const forme = `${contact.formeJuridique} (${contact.formeJuridiqueLongue})`;
const formeEtCapital = contact.capital
  ? `${forme} au capital de ${contact.capital}`
  : `${forme} — capital social : ⚠ à compléter`;
---

<Base
  titre="Mentions légales"
  description={`Mentions légales du site ${site.nom}.`}
>
  <section class="container-page pt-16 pb-8">
    <TitreSection niveau={1} surtitre="Informations" titre="Mentions légales" />

    <div class="mt-12 max-w-2xl space-y-10 text-sm leading-relaxed text-encre/75">
      {
        manquants > 0 && (
          <div class="rounded-md border border-terre-200 bg-terre-50 p-5 text-terre-800">
            <strong class="font-medium">Page à compléter avant mise en ligne.</strong>
            Les mentions légales sont obligatoires (art. 6-III de la LCEN).
            {manquants > 1
              ? ` Les ${manquants} valeurs manquantes sont à renseigner dans `
              : ' La valeur manquante est à renseigner dans '}
            <code class="rounded bg-white px-1.5 py-0.5">src/data/site.ts</code>.
          </div>
        )
      }

      <div>
        <h2 class="text-xl text-encre">Éditeur du site</h2>
        <ul class="mt-4 space-y-1.5">
          <li>Dénomination : {site.nom}</li>
          <li>Forme juridique : {formeEtCapital}</li>
          <li>Siège social : {aRemplir(contact.adresse)}</li>
          <li>SIRET : {aRemplir(contact.siret)}</li>
          <li>Immatriculation : {aRemplir(contact.rcs)}</li>
          <li>TVA intracommunautaire : {aRemplir(contact.tva)}</li>
          <li>Téléphone : {aRemplir(telephoneInsecable(contact.telephone))}</li>
          <li>Email : {aRemplir(contact.email)}</li>
          <li>
            Directeur de la publication : {aRemplir(contact.directeurPublication)}
          </li>
          <li>Statut : société à mission (art. L210-10 du code de commerce)</li>
        </ul>
      </div>

      {
        rgeEnCours && (
          <div>
            <h2 class="text-xl text-encre">Qualification professionnelle</h2>
            <p class="mt-4">
              {rge.certificat}, délivré par {rge.organisme} et valable jusqu'au{' '}
              {rge.fin.split('-').reverse().join('/')}. Qualification « Reconnu
              Garant de l'Environnement » portant sur : {rge.domaines.join(', ')}.
            </p>
          </div>
        )
      }

      <div>
        <h2 class="text-xl text-encre">Assurance professionnelle</h2>
        {/* Un seul contrat porte les deux garanties, la loi n'impose de
            mentionner que la décennale : les nommer toutes les deux évite de
            laisser croire que la responsabilité civile n'est pas couverte. */}
        <p class="mt-4">
          {site.nom} a souscrit auprès de {aRemplir(contact.assurance.assureur)}
          {contact.assurance.adresse && ` (${contact.assurance.adresse})`} une
          assurance de responsabilité civile professionnelle et de garantie
          décennale, contrat n° {aRemplir(contact.assurance.contrat)}.
        </p>
        <p class="mt-2">
          Couverture géographique : {contact.assurance.couverture}.
        </p>
      </div>

      <div>
        <h2 class="text-xl text-encre">Hébergement</h2>
        {/* Le téléphone est libellé : le numéro d'OVH est un court « 1007 »
            qu'on ne reconnaîtrait pas comme tel en fin d'énumération. */}
        <p class="mt-4">
          {hebergeur.nom} — {hebergeur.adresse}. Téléphone : {hebergeur.telephone}.
        </p>
      </div>

      <div>
        <h2 class="text-xl text-encre">Propriété intellectuelle</h2>
        <p class="mt-4">
          L'ensemble des contenus de ce site (textes, photographies, logotype)
          est la propriété de {site.nom}, sauf mention contraire. Toute
          reproduction sans autorisation préalable est interdite.
        </p>
      </div>

      <div>
        <h2 class="text-xl text-encre">Données personnelles</h2>
        <p class="mt-4">
          Les données transmises via le formulaire de contact sont utilisées
          uniquement pour répondre à votre demande et ne font l'objet d'aucune
          cession à des tiers. Conformément au RGPD, vous disposez d'un droit
          d'accès, de rectification et de suppression de vos données, en nous
          contactant {contact.email ? `à ${contact.email}` : `au ${aRemplir(telephoneInsecable(contact.telephone))}`}.
        </p>
        {
          contact.web3formsCle && (
            <p class="mt-4">
              L'envoi du formulaire transite par Web3Forms, prestataire
              technique qui réexpédie le message par email sans le conserver.
              Ses serveurs sont situés hors de l'Union européenne. Si vous
              préférez éviter cet intermédiaire, écrivez-nous directement par
              email ou par téléphone.
            </p>
          )
        }
      </div>

      <div>
        <h2 class="text-xl text-encre">Cookies</h2>
        <p class="mt-4">
          Ce site ne dépose aucun cookie et n'utilise aucun outil de mesure
          d'audience. Les polices de caractères sont hébergées sur le site
          lui-même : aucune requête n'est adressée à un service tiers lors de la
          consultation des pages.
        </p>
      </div>
    </div>
  </section>
</Base>
