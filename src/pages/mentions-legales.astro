---
import Base from '~/layouts/Base.astro';
import TitreSection from '~/components/TitreSection.astro';
import { site, contact, hebergeur, rgeEnCours } from '~/data/site';
import { pageMentions } from '~/data/pages';
import { remplir } from '~/lib/gabarit';
import { telephoneInsecable } from '~/lib/texte';

const aRemplir = (v: string) => v || '⚠ à compléter';

// Le bandeau d'avertissement ne s'affiche que s'il reste effectivement quelque
// chose à renseigner : une alerte qui survit à sa cause finit par être lue
// comme un élément de décor.
const manquants = [
  contact.email,
  contact.adresse,
  contact.capital,
  contact.rcs,
  contact.tva,
  contact.directeurPublication,
  contact.assurance.assureur,
].filter((v) => !v).length;

// « SAS (société par actions simplifiée à associé unique) au capital de
// 6 000 € ». Le capital est une mention imposée (art. R123-237 du code de
// commerce) : tant qu'il manque, la page le réclame en clair au lieu de laisser
// un blanc que personne ne remarquerait.
const forme = `${contact.formeJuridique} (${contact.formeJuridiqueLongue})`;
const formeEtCapital = contact.capital
  ? `${forme} au capital de ${contact.capital}`
  : `${forme} — capital social : ⚠ à compléter`;

// L'adresse où exercer ses droits RGPD : l'email s'il est renseigné, le
// téléphone à défaut. La phrase qui l'accueille vient du CMS, mais pas ce
// choix-là — il dépend de ce qui est rempli, pas de ce qui est écrit.
const ouNousEcrire = contact.email
  ? `à ${contact.email}`
  : `au ${aRemplir(telephoneInsecable(contact.telephone))}`;
---

<Base titre={pageMentions.titreOnglet} description={pageMentions.description}>
  <section class="container-page pt-16 pb-8">
    <TitreSection
      niveau={1}
      surtitre={pageMentions.surtitre}
      titre={pageMentions.titre}
    />

    {/* `mesure-lecture` et non `max-w-2xl` : la première borne est en `ch`,
        donc solidaire de la taille du texte, la seconde en `rem`. En
        `text-sm`, 42 rem laissaient passer 107 signes par ligne — l'œil perd
        le début de la suivante bien avant. Mesuré, pas estimé ; voir
        global.css pour le calcul. */}
    <div class="mesure-lecture mt-12 space-y-10 text-sm leading-relaxed text-encre/75">
      {
        manquants > 0 && (
          <div class="rounded-md border border-terre-200 bg-terre-50 p-5 text-terre-800">
            <strong class="font-medium">Page à compléter avant mise en ligne.</strong>
            Les mentions légales sont obligatoires (art. 6-III de la LCEN).
            {manquants > 1
              ? ` Les ${manquants} valeurs manquantes sont à renseigner dans `
              : ' La valeur manquante est à renseigner dans '}
            l'entrée « Entreprise » du CMS.
          </div>
        )
      }

      <div>
        <h2 class="text-xl text-encre">{pageMentions.titreEditeur}</h2>
        <ul class="mt-4 space-y-1.5">
          <li>Dénomination : {site.nom}</li>
          <li>Forme juridique : {formeEtCapital}</li>
          <li>Siège social : {aRemplir(contact.adresse)}</li>
          <li>SIRET : {aRemplir(contact.siret)}</li>
          <li>Immatriculation : {aRemplir(contact.rcs)}</li>
          <li>TVA intracommunautaire : {aRemplir(contact.tva)}</li>
          <li>Téléphone : {aRemplir(telephoneInsecable(contact.telephone))}</li>
          <li>Email : {aRemplir(contact.email)}</li>
          <li>
            Directeur de la publication : {aRemplir(contact.directeurPublication)}
          </li>
        </ul>
      </div>

      {
        rgeEnCours && (
          <div>
            <h2 class="text-xl text-encre">{pageMentions.titreQualification}</h2>
            <p class="mt-4">{pageMentions.qualification}</p>
          </div>
        )
      }

      <div>
        <h2 class="text-xl text-encre">{pageMentions.titreAssurance}</h2>
        {/* Un seul contrat porte les deux garanties, la loi n'impose de
            mentionner que la décennale : les nommer toutes les deux évite de
            laisser croire que la responsabilité civile n'est pas couverte. */}
        <p class="mt-4">
          {site.nom} a souscrit auprès de {aRemplir(contact.assurance.assureur)}
          {contact.assurance.adresse && ` (${contact.assurance.adresse})`} une
          assurance de responsabilité civile professionnelle et de garantie
          décennale, contrat n° {aRemplir(contact.assurance.contrat)}.
        </p>
        <p class="mt-2">
          Couverture géographique : {contact.assurance.couverture}.
        </p>
      </div>

      <div>
        <h2 class="text-xl text-encre">{pageMentions.titreHebergement}</h2>
        {/* Le téléphone est libellé : le numéro d'OVH est un court « 1007 »
            qu'on ne reconnaîtrait pas comme tel en fin d'énumération. */}
        <p class="mt-4">
          {hebergeur.nom} — {hebergeur.adresse}. Téléphone : {hebergeur.telephone}.
        </p>
      </div>

      <div>
        <h2 class="text-xl text-encre">{pageMentions.titrePropriete}</h2>
        <p class="mt-4">{pageMentions.propriete}</p>
      </div>

      <div>
        <h2 class="text-xl text-encre">{pageMentions.titreDonnees}</h2>
        <p class="mt-4">{pageMentions.donnees}</p>
        <p class="mt-4">
          {remplir(pageMentions.droits[0], { contact: ouNousEcrire })}
          <a class="underline underline-offset-2" href="https://www.cnil.fr/fr/plaintes">
            {pageMentions.libelleLienCnil}
          </a>
          {pageMentions.droits[1]}
        </p>
        {contact.web3formsCle && <p class="mt-4">{pageMentions.web3forms}</p>}
      </div>

      <div>
        <h2 class="text-xl text-encre">{pageMentions.titreCookies}</h2>
        <p class="mt-4">{pageMentions.cookies}</p>
      </div>
    </div>
  </section>
</Base>
