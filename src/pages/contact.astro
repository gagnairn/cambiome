---
import Base from '~/layouts/Base.astro';
import TitreSection from '~/components/TitreSection.astro';
import FormulaireContact from '~/components/FormulaireContact.astro';
import { site, contact } from '~/data/site';

const aDesCoordonnees = Boolean(
  contact.telephone || contact.email || contact.adresse
);
---

<Base
  titre="Contact"
  description={`Contacter CAMBIOME pour un projet de charpente, de couverture ou de rénovation thermique — ${site.zone}.`}
>
  <section class="container-page pt-16">
    <TitreSection surtitre="Contact" titre="Parlons de votre projet">
      <p>
        Décrivez-nous le bâtiment, ce que vous souhaitez faire et l'échéance que
        vous avez en tête. Nous nous déplaçons pour évaluer le chantier avant
        tout chiffrage.
      </p>
    </TitreSection>

    <div class="mt-14 grid gap-14 lg:grid-cols-[1fr_20rem]">
      <div>
        <FormulaireContact />
      </div>

      <aside class="lg:border-l lg:border-sable-200 lg:pl-10">
        <h2 class="font-display text-xs tracking-[0.28em] text-ardoise-600 uppercase">
          Nous joindre
        </h2>

        {
          aDesCoordonnees ? (
            <ul class="mt-6 space-y-5 text-sm">
              {contact.telephone && (
                <li>
                  <span class="block text-encre/50">Téléphone</span>
                  <a
                    class="text-encre underline-offset-4 hover:underline"
                    href={`tel:${contact.telephone.replace(/\s/g, '')}`}
                  >
                    {contact.telephone}
                  </a>
                </li>
              )}
              {contact.email && (
                <li>
                  <span class="block text-encre/50">Email</span>
                  <a
                    class="text-encre underline-offset-4 hover:underline"
                    href={`mailto:${contact.email}`}
                  >
                    {contact.email}
                  </a>
                </li>
              )}
              {contact.adresse && (
                <li>
                  <span class="block text-encre/50">Atelier</span>
                  <span class="text-encre">{contact.adresse}</span>
                </li>
              )}
            </ul>
          ) : (
            <p class="mt-6 text-sm leading-relaxed text-encre/60">
              Coordonnées à renseigner dans{' '}
              <code class="rounded bg-sable-100 px-1.5 py-0.5 text-[0.8em]">src/data/site.ts</code>.
            </p>
          )
        }

        <h2 class="mt-10 font-display text-xs tracking-[0.28em] text-ardoise-600 uppercase">
          Zone d'intervention
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-encre/70">{site.zone}.</p>
      </aside>
    </div>
  </section>
</Base>
