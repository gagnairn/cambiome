---
import Base from '~/layouts/Base.astro';
import TitreSection from '~/components/TitreSection.astro';
import FormulaireContact from '~/components/FormulaireContact.astro';
import { site, contact, atelier } from '~/data/site';
import { pageContact } from '~/data/pages';
import { telephoneInsecable } from '~/lib/texte';
import { heureFrancaise, libelleJours } from '~/lib/horaires';

const aDesCoordonnees = Boolean(
  contact.telephone || contact.email || contact.adresseVisible || contact.instagram
);

/**
 * L'adresse d'expédition, destinataire compris — une adresse sans nom ne
 * s'affranchit pas. Composée ici plutôt que dans le balisage : trois
 * expressions collées entre deux balises pour insérer un simple retour à la
 * ligne, c'est illisible, et le parseur de `astro check` s'y perd.
 *
 * Vide dès que le siège est déjà l'adresse affichée plus haut, auquel cas la
 * ligne répéterait la précédente sous un second intitulé.
 */
const courrier =
  contact.adresseEstAtelier && contact.adresse
    ? `${site.nom}\n${contact.adresse.replace(/,\s*/, ',\n')}`
    : '';

/**
 * `https://instagram.com/cambiome_charpente` -> `@cambiome_charpente`.
 * On affiche le pseudonyme et non l'URL : c'est sous cette forme qu'on le
 * cherche dans l'application, et une URL complète dans une colonne étroite se
 * coupe n'importe où. Le lien, lui, garde l'adresse entière.
 */
const pseudoInstagram = contact.instagram
  ? `@${contact.instagram.replace(/\/+$/, '').split('/').pop()}`
  : '';
---

<Base titre={pageContact.titreOnglet} description={pageContact.description}>
  <section class="container-page pt-16">
    <TitreSection niveau={1} surtitre={pageContact.surtitre} titre={pageContact.titre}>
      <p>{pageContact.texte}</p>
    </TitreSection>

    <div class="mt-14 grid gap-14 lg:grid-cols-[1fr_20rem]">
      <div>
        <FormulaireContact />
      </div>

      {/* Le repère est nommé par son propre titre plutôt que par un
          `aria-label` qui redirait la même chose à côté. */}
      <aside
        aria-labelledby="titre-nous-joindre"
        class="lg:border-l lg:border-sable-200 lg:pl-10"
      >
        <h2
          id="titre-nous-joindre"
          class="font-display text-xs tracking-[0.28em] text-ciel-600 uppercase"
        >
          Nous joindre
        </h2>

        {
          aDesCoordonnees ? (
            <ul class="mt-6 space-y-5 text-sm">
              {contact.telephone && (
                <li>
                  <span class="block text-encre/65">Téléphone</span>
                  <a
                    class="text-encre underline-offset-4 hover:underline"
                    href={`tel:${contact.telephone.replace(/\s/g, '')}`}
                  >
                    {telephoneInsecable(contact.telephone)}
                  </a>
                </li>
              )}
              {contact.email && (
                <li>
                  <span class="block text-encre/65">Email</span>
                  <a
                    class="text-encre underline-offset-4 hover:underline"
                    href={`mailto:${contact.email}`}
                  >
                    {contact.email}
                  </a>
                </li>
              )}
              {contact.adresseVisible && (
                <li>
                  {/* Deux adresses sur la même page, et c'est voulu : elles ne
                      servent pas à la même chose. Ce qui rend la chose sûre,
                      c'est que chacune est nommée par son usage — « Atelier »
                      pour venir, « Courrier » pour écrire — et non par sa
                      nature juridique, que le visiteur n'a pas à démêler. Sans
                      ces libellés, deux adresses côte à côte enverraient une
                      partie des gens à la mauvaise. */}
                  <span class="block text-encre/65">
                    {contact.adresseEstAtelier ? 'Atelier' : 'Adresse postale'}
                  </span>
                  {/* Coupée après la voie, comme au pied de page. La donnée
                      reste sur une ligne : les mentions légales la veulent
                      d'un tenant. */}
                  <span class="block whitespace-pre-line text-encre">
                    {contact.adresseVisible.replace(/,\s*/, ',\n')}
                  </span>
                  {/* Les horaires ne s'affichent que s'ils existent, et c'est
                      la même condition qui fait passer le balisage structuré
                      en « établissement où l'on se rend ». Page et balisage
                      disent donc toujours la même chose : sans horaires, ni
                      l'une ni l'autre n'invite à venir. */}
                  {atelier.accueille && (
                    <span class="mt-2 block text-encre/70">
                      {atelier.horaires.map((h) => (
                        <span class="block">
                          {libelleJours(h.jours)}, {heureFrancaise(h.ouverture)}
                          {' – '}
                          {heureFrancaise(h.fermeture)}
                        </span>
                      ))}
                    </span>
                  )}
                  {/* Sous l'adresse et non dans une ligne à part : c'est un
                      complément de l'adresse, pas une coordonnée de plus. Le
                      lien mène à la fiche Google de l'établissement, d'où le
                      visiteur lance l'itinéraire depuis là où il est — le site
                      n'a pas à le lui demander, et n'embarque donc aucune
                      carte : ce serait un traceur Google sur une page qui n'en
                      pose aucun. */}
                  {contact.ficheGoogle && (
                    <a
                      class="mt-2 inline-block text-encre underline underline-offset-4 hover:no-underline"
                      href={contact.ficheGoogle}
                      rel="noopener"
                    >
                      Itinéraire
                    </a>
                  )}
                </li>
              )}
              {/* Le courrier va au siège, pas à l'atelier — et la raison n'a
                  rien d'évident pour qui écrit : c'est là qu'est domiciliée la
                  société, donc là qu'aboutit un recommandé. La ligne ne
                  s'affiche que si le siège est bien une AUTRE adresse que
                  celle donnée plus haut ; sinon elle répéterait mot pour mot
                  la précédente sous un second intitulé.

                  Le nom de la société est repris au-dessus de la voie parce
                  qu'une enveloppe le demande — une adresse sans destinataire
                  ne s'affranchit pas. */}
              {courrier && (
                <li>
                  <span class="block text-encre/65">Courrier</span>
                  <span class="block whitespace-pre-line text-encre">{courrier}</span>
                </li>
              )}
              {/* Instagram figure déjà au pied de page, mais sous l'angle du
                  portfolio — « Nos chantiers sur Instagram ». Ici c'est une
                  voie pour joindre l'entreprise, au même titre que le
                  téléphone : d'où le pseudonyme plutôt qu'une invitation à
                  regarder. `rel="me"` déclare le compte comme appartenant à
                  l'entreprise, `noopener` va avec tout lien sortant. */}
              {contact.instagram && (
                <li>
                  <span class="block text-encre/65">Instagram</span>
                  <a
                    class="text-encre underline-offset-4 hover:underline"
                    href={contact.instagram}
                    rel="me noopener"
                  >
                    {pseudoInstagram}
                  </a>
                </li>
              )}
            </ul>
          ) : (
            /* Ce repli ne s'affiche que si les trois coordonnées sont vides,
               c'est-à-dire jamais en ligne. Il s'adresse donc à qui tient le
               site, et le renvoie là où il peut agir : l'entrée
               « Textes de service → L'entreprise » du CMS, et non un fichier
               du dépôt qu'il n'ouvrira pas. */
            <p class="mt-6 text-sm leading-relaxed text-encre/65">
              Coordonnées à renseigner dans le CMS, entrée
              « Textes de service → L'entreprise ».
            </p>
          )
        }

        <h2 class="mt-10 font-display text-xs tracking-[0.28em] text-ciel-600 uppercase">
          Zone d'intervention
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-encre/70">{site.zone}.</p>
      </aside>
    </div>
  </section>
</Base>
