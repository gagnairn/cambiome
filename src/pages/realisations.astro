---
import Base from '~/layouts/Base.astro';
import TitreSection from '~/components/TitreSection.astro';
import GalerieRealisations from '~/components/GalerieRealisations.astro';
import AppelContact from '~/components/AppelContact.astro';
import { realisations } from '~/data/realisations';
import { pageRealisations } from '~/data/pages';
---

<Base titre={pageRealisations.titreOnglet} description={pageRealisations.description}>
  <section class="container-page pt-16">
    <TitreSection
      niveau={1}
      surtitre={pageRealisations.surtitre}
      titre={pageRealisations.titre}
    >
      <p>{pageRealisations.texte}</p>
    </TitreSection>

    <div class="mt-12">
      <GalerieRealisations items={realisations} niveau={2} eager={3} />
    </div>
  </section>

  <AppelContact />
</Base>
