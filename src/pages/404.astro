---
import Base from '~/layouts/Base.astro';
import Bouton from '~/components/Bouton.astro';
import { page404 } from '~/data/pages';
import { lien } from '~/lib/base';
---

{/* `noindex` : cette page est servie en réponse à n'importe quelle URL fausse,
    elle n'a donc pas de contenu propre à indexer.

    Le statut 404 qui l'accompagne ne va pas de soi : Apache ne devine pas
    qu'il faut servir ce fichier, c'est `ErrorDocument 404 /404.html` dans
    public/.htaccess qui le lui dit. Si ce fichier caché venait à manquer du
    dépôt, Apache rendrait sa propre page d'erreur — d'où le garde-fou qui
    l'exige dans le job `deploy`.

    La balise `noindex`, elle, vaut quel que soit l'hébergeur. Elle supprime du
    même coup le `<link rel="canonical">` généré vers /404/, une adresse qui
    n'existe pas : voir le <head> de Base.astro. */}
<Base titre={page404.titreOnglet} description={page404.description} noindex>
  <section class="container-page flex min-h-[55vh] flex-col justify-center py-24">
    <p class="surtitre">
      {page404.surtitre}
    </p>
    <h1 class="mt-4 text-4xl leading-tight sm:text-5xl">{page404.titre}</h1>
    <p class="mt-6 max-w-md text-encre/70">{page404.texte}</p>
    <div class="mt-9 flex flex-wrap gap-3">
      <Bouton href={lien('/')}>{page404.boutonAccueil}</Bouton>
      <Bouton href={lien('/realisations')} variante="contour">
        {page404.boutonRealisations}
      </Bouton>
    </div>
  </section>
</Base>
