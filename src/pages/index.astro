---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Bouton from '~/components/Bouton.astro';
import TitreSection from '~/components/TitreSection.astro';
import CarteMetier from '~/components/CarteMetier.astro';
import GalerieRealisations from '~/components/GalerieRealisations.astro';
import AppelContact from '~/components/AppelContact.astro';
import { site, metiers, demarche } from '~/data/site';
import { realisations } from '~/data/realisations';
import { accueil } from '~/data/pages';
import hero from '~/assets/realisations/comble-charpente-chantier.jpg';
import { lien } from '~/lib/base';

const apercu = realisations.slice(0, 3);
---

<Base titre="accueil">
  <!-- Hero. `surface-sombre` : sous le voile, l'anneau de focus des deux
       boutons passe au blanc — voir global.css. -->
  <section class="surface-sombre relative">
    <div class="absolute inset-0">
      <!--
        La photo est en portrait (1542 × 2048). Sur un écran large,
        `object-cover` n'en montre qu'une bande centrale — rampant en panneaux,
        percée sur le paysage, poutre sur tréteaux ; sur mobile, le cadrage
        d'origine passe presque entier. `widths` s'arrête à la largeur native,
        il n'y a rien à gagner à demander plus grand.

        `object-position` descend le cadrage à 68 % au lieu du centre : les
        tréteaux et la poutre qu'ils portent sont dans le tiers bas de la photo,
        et un cadrage centré les coupait au ras du bord inférieur. À 68 % ils
        passent entiers, sous le bloc de texte, sans perdre la panne faîtière
        ni la percée sur le paysage. Sans effet sur mobile : la photo y déborde
        en largeur, pas en hauteur, seul l'axe horizontal joue.

        `quality` est descendue sous le défaut : la photo est saturée de détail
        fin (panneaux OSB, feuillage, sciure) qui coûte cher à encoder, et le
        voile sombre posé par-dessus masque de toute façon les artefacts.
      -->
      <Image
        src={hero}
        alt=""
        widths={[640, 900, 1200, 1542]}
        sizes="100vw"
        quality={62}
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover object-[50%_68%]"
      />
      {/* Le voile reste le plus épais en haut et au milieu, là où se posent le
          titre et le paragraphe ; il s'allège en bas pour laisser lire les
          tréteaux, sans descendre au point de fragiliser le bouton en contour. */}
      <div class="absolute inset-0 bg-gradient-to-b from-encre/70 via-encre/50 to-encre/45"></div>
    </div>

    <div class="relative container-page flex min-h-[78vh] flex-col justify-center py-24">
      <p class="font-display text-xs tracking-[0.32em] text-white/80 uppercase">
        {site.baseline}
      </p>
      <h1 class="mt-6 max-w-3xl text-4xl leading-[1.1] text-white sm:text-5xl lg:text-6xl">
        {accueil.hero.titre}
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-white/85">
        {accueil.hero.texte}
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <Bouton href={lien('/metiers')} variante="clair">{accueil.hero.boutonMetiers}</Bouton>
        <Bouton
          href={lien('/contact')}
          variante="contour"
          class="border-white/50 text-white hover:border-white hover:bg-white/10"
        >
          {accueil.hero.boutonContact}
        </Bouton>
      </div>
    </div>
  </section>

  <!-- Métiers -->
  <section class="container-page mt-24">
    <TitreSection surtitre={accueil.metiers.surtitre} titre={accueil.metiers.titre}>
      <p>{accueil.metiers.texte}</p>
    </TitreSection>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {metiers.map((m) => <CarteMetier metier={m} evite={apercu} />)}
    </div>
  </section>

  <!-- Démarche -->
  <section class="mt-24 bg-sable-100 py-24">
    <div class="container-page">
      <TitreSection surtitre={accueil.demarche.surtitre} titre={accueil.demarche.titre}>
        <p>{accueil.demarche.texte}</p>
      </TitreSection>

      {/* Une liste ordonnée et non une liste de définitions. Un `<dl>` n'admet
          entre ses `<div>` que des `<dt>` et des `<dd>` : le numéro d'étape,
          posé dans un `<span>` à côté, en faisait un balisage invalide — relevé
          par axe. Et c'est la bonne structure sur le fond, ces quatre entrées
          étant des étapes qui se suivent, pas des termes définis. La page
          Démarche présente déjà la même donnée en `<ol>`, les deux se
          répondent. Le numéro reste dans le flux : il est lu comme le début de
          l'étape, ce qu'il est. */}
      <ol class="mt-12 grid list-none gap-x-10 gap-y-10 sm:grid-cols-2">
        {
          demarche.map((d, i) => (
            <li class="border-t border-sable-300 pt-6">
              <span class="font-display text-sm text-ardoise-500">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-2 font-display text-xl font-light">{d.titre}</h3>
              <p class="mt-3 text-sm leading-relaxed text-encre/70">{d.texte}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-12">
        <Bouton href={lien('/demarche')} variante="contour">
          {accueil.demarche.bouton}
        </Bouton>
      </div>
    </div>
  </section>

  <!-- Réalisations -->
  <section class="container-page mt-24">
    <TitreSection
      surtitre={accueil.realisations.surtitre}
      titre={accueil.realisations.titre}
    />
    <div class="mt-12">
      <GalerieRealisations items={apercu} />
    </div>
    <div class="mt-10">
      <Bouton href={lien('/realisations')} variante="contour">
        {accueil.realisations.bouton}
      </Bouton>
    </div>
  </section>

  <AppelContact />
</Base>
